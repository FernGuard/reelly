# Copy the keys you need into your shell, or into ~/.reelly/config.json.
# NEVER commit a filled copy of this file.
#
#   export GEMINI_API_KEY=...
#   export OPENAI_API_KEY=...
#   export FAL_KEY=...
#
# JSON equivalent (~/.reelly/config.json, chmod 600):
# {
#   "gemini_api_key": "...",
#   "openai_api_key": "...",
#   "fal_key": "...",
#   "anthropic_api_key": "...",
#   "huggingface_token": "...",
#   "projects": "~/reelly-projects"
# }

# Required for the full pipeline
GEMINI_API_KEY=
OPENAI_API_KEY=
FAL_KEY=

# Optional: PRISM social-video analyzer (python -m reelly.prism)
ANTHROPIC_API_KEY=

# Optional: local speaker diarization (uv sync --extra diarize)
HUGGINGFACE_TOKEN=

# Optional overrides
# REELLY_PROJECTS=~/reelly-projects
# FFMPEG=/usr/bin/ffmpeg
# FFPROBE=/usr/bin/ffprobe
# CHROME_PATH=/usr/bin/google-chrome
